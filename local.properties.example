# Copy this file to `local.properties` (already gitignored) and fill in real values.
# local.properties is never committed — this is where per-developer / per-machine
# secrets and SDK paths live.

# Consumed by BuildKonfigConventionPlugin (build-logic) and exposed at runtime
# as BuildKonfig.API_KEY, sent as the `x-api-key` header on every request
# (see core/data/.../networking/HttpClientFactory.kt). The build fails fast
# if this is missing.
API_KEY=your-dev-api-key

# ---------------------------------------------------------------------------
# Which app and which backends (specs/010-entornos)
# ---------------------------------------------------------------------------
# Two apps, picked at build time:
#
#   ./gradlew :composeApp:assembleDebug                               # PRE (default)
#   ./gradlew :composeApp:assembleRelease -Pgranatum.build=pro        # PRO, the store app
#
# PRE has an environment selector (Local, PRE, PRO, Demo); PRO only knows production.
# Uncomment to make Android Studio's Run button build PRO:
# granatum.build=pro
#
# Every key below resolves in this order: Gradle property (-PKEY=value, handy
# for CI), then this file, then a built-in default.

# Local (the developer's machine) needs NOTHING here — it already defaults to the host
# on both platforms. Android uses the 10.0.2.2 emulator alias; iOS uses localhost,
# because the simulator shares the Mac's network and does not understand 10.0.2.2.
# Override only if your backend is not on :8080.
# BASE_URL_HTTP=http://10.0.2.2:8080/api
# BASE_URL_HTTP_IOS=http://localhost:8080/api

# PRE: optional in the PRE app (without it the option does not show). Must be https://.
# BASE_URL_HTTP_PRE=https://pre.example.com/api
# PRO: optional in the PRE app, REQUIRED by the PRO app. Must be https://.
# BASE_URL_HTTP_PRO=https://api.example.com/api

# ---------------------------------------------------------------------------
# Product images (specs/011-inventario-productos)
# ---------------------------------------------------------------------------
# A Supabase Storage project per environment, with a PUBLIC bucket whose policy lets the key
# insert objects. All optional: without them products are saved without an image. Must be https://.
# Local and PRE use PRE's storage; the PRO app only carries PRO's.
# STORAGE_URL_PRE=https://your-pre-project.supabase.co
# STORAGE_KEY_PRE=your-pre-anon-key
# STORAGE_URL_PRO=https://your-pro-project.supabase.co
# STORAGE_KEY_PRO=your-pro-anon-key
# STORAGE_BUCKET=inventario

# Uncomment and set if the Android Gradle Plugin can't auto-detect your SDK.
# sdk.dir=/Users/you/Library/Android/sdk
