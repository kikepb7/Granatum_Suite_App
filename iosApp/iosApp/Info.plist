<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<!-- User-facing name on the home screen. Kept separate from PRODUCT_NAME
	     (Configuration/Config.xcconfig), which names the built product and is
	     better off without a space. If iOS truncates this on the springboard,
	     add a shorter CFBundleName here rather than changing Android. -->
	<key>CFBundleDisplayName</key>
	<string>Granatum Suite</string>
	<!-- Invoicing photographs paper invoices to upload them (specs/008-facturacion). The
	     gallery uses PHPicker, which needs no permission. -->
	<key>NSCameraUsageDescription</key>
	<string>Granatum usa la cámara para fotografiar las facturas que subes.</string>
	<!-- TODO: replace with your own custom URI scheme, matching AndroidManifest.xml -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>yourapp.example.com</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>yourapp</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
